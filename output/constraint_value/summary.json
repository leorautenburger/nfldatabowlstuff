{
  "metric": "Constraint Value",
  "definition": "Per TE: mean box-count residual (observed defendersInBox - context-expected) on his inline/wing snaps minus on his detached snaps. Positive = defenses put more men in the box (vs expectation) when he is inline than when he is detached. Components: same inline-detached difference for deep-defender count, two-high (tracking) and man-coverage residuals. League effects: mean residual per play state with game-bootstrap CIs.",
  "higher_is_better": true,
  "parameters": {
    "deep_x_rel_at_snap": 10.0,
    "two_high_min_deep": 2,
    "blitz_min_rushers": 5,
    "pff_two_high_shells": [
      "Cover-2",
      "2-Man",
      "Quarters",
      "Cover-6"
    ],
    "inline_alignments": [
      "inline",
      "wing"
    ],
    "min_snaps_each_state_top5": 25,
    "n_bootstrap": 1000,
    "bootstrap_unit": "gameId",
    "context_features_primary": [
      "down",
      "yardsToGo",
      "yards_to_goal",
      "quarter",
      "score_diff",
      "secs_left_half",
      "n_rb",
      "n_wr",
      "n_detached_nonte"
    ],
    "context_features_sensitivity": [
      "down",
      "yardsToGo",
      "yards_to_goal",
      "quarter",
      "score_diff",
      "secs_left_half",
      "n_rb",
      "n_wr",
      "n_detached_nonte",
      "formation_code"
    ],
    "hgb": {
      "max_iter": 200,
      "learning_rate": 0.05,
      "max_leaf_nodes": 15,
      "min_samples_leaf": 40,
      "l2_regularization": 1.0,
      "random_state": 42
    },
    "play_state_rules": "no_te: n_te_on_field==0; te_inline: >=1 TE inline/wing and none detached; te_detached: >=1 detached and none inline/wing; te_mixed: both; te_backfield_only: rest",
    "man_definition": "pff_passCoverageType == 'Man' (Zone and Other = 0)",
    "eb_shrinkage": "eb_shrink_mean on the difference with n_eff = 1/(1/n_inline + 1/n_detached), pooled within player-state SD",
    "pooled_within_sd_box_res": 0.7420936724817858
  },
