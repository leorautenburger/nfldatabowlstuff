    "red_zone": 0,
    "dropBackType": 0,
    "offenseFormation": 0,
    "pff_passCoverageType": 0
  },
  "constraint_note": "rushers_minus_blockers (+1) added beyond the requested set so that removing a TE blocker cannot lower expected pressure through the derived feature",
  "excluded_features": [
    "time_to_throw (caused by pressure)",
    "player identity"
  ],
